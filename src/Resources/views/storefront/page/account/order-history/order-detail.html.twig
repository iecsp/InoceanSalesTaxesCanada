{% sw_extends '@Storefront/storefront/page/account/order-history/order-detail.html.twig' %}

{% block page_account_order_item_detail_vat %}
    {% if order.taxStatus !== constant('Shopware\\Core\\Checkout\\Cart\\Price\\Struct\\CartPrice::TAX_STATE_FREE') %}

        {#
            Aggregate the Canadian breakdown from the line item payloads and print it
            directly. Matching it against order.price.calculatedTaxes by rate used to
            drop any band whose rate was not present there, and to print a band twice
            when two bands shared a rate.
        #}
        {% set taxTotals = {} %}
        {% for taxItem in order.nestedLineItems %}
            {% if taxItem.payload.inoceanCanadaTaxInfo is defined and taxItem.payload.inoceanCanadaTaxInfo is not empty %}
                {% for taxInfo in taxItem.payload.inoceanCanadaTaxInfo %}
                    {% set currentTaxData = taxTotals[taxInfo.name]|default({ 'rate': taxInfo.rate, 'total': 0 }) %}
                    {% set taxTotals = taxTotals|merge({ (taxInfo.name): currentTaxData|merge({ 'total': currentTaxData.total + taxInfo.tax }) }) %}
                {% endfor %}
            {% endif %}
            {% if taxItem.payload.inoceanShippingTaxInfo is defined and taxItem.payload.inoceanShippingTaxInfo is not empty %}
                {% for tax in taxItem.payload.inoceanShippingTaxInfo %}
                    {% set currentTaxData = taxTotals[tax.name]|default({ 'rate': tax.rate, 'total': 0 }) %}
                    {% set taxTotals = taxTotals|merge({ (tax.name): currentTaxData|merge({ 'total': currentTaxData.total + tax.tax }) }) %}
                {% endfor %}
            {% endif %}
        {% endfor %}

        {% block page_account_order_item_detail_vat_label %}
            {% if taxTotals is not empty %}
                {% for taxName, taxData in taxTotals %}
                    {% if taxData.total != 0 %}
                        <dt class="col-6 col-md-8">
                            {{ ('salseTaxCanada.checkout.taxes.tax' ~ taxName)|trans({'%taxRate%': taxData.rate})|sw_sanitize }}
                        </dt>
                        <dd class="col-6 col-md-4">
                            {{ taxData.total|currency(order.currency.isoCode) }}
                        </dd>
                    {% endif %}
                {% endfor %}
            {% else %}
                {% for calculatedTax in order.price.calculatedTaxes %}
                    <dt class="col-6 col-md-8">
                        {{ 'salseTaxCanada.checkout.taxes.taxTAX'|trans({
                            '%taxRate%':  calculatedTax.taxRate
                        })|sw_sanitize }}
                    </dt>
                    <dd class="col-6 col-md-4">
                        {{ calculatedTax.tax|currency(order.currency.isoCode) }}
                    </dd>
                {% endfor %}
            {% endif %}
        {% endblock %}

        {% block page_account_order_item_detail_vat_value %}{% endblock %}

    {% endif %}
{% endblock %}