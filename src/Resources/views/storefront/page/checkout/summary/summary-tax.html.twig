{% sw_extends '@Storefront/storefront/page/checkout/summary/summary-tax.html.twig' %}

{% block page_checkout_summary_taxes %}
    {% if app.request.attributes.get('_route') === 'frontend.checkout.finish.page' %}

        {# Presence of the breakdown, not the shipping country, decides which rows to print. #}
        {% set taxTotals = {} %}

        {% for taxItem in page.order.lineItems %}
            {% if taxItem.payload.inoceanCanadaTaxInfo is defined and taxItem.payload.inoceanCanadaTaxInfo is not empty %}
                {% for taxInfo in taxItem.payload.inoceanCanadaTaxInfo %}
                    {% set currentTaxData = taxTotals[taxInfo.name]|default({ 'rate': taxInfo.rate, 'total': 0 }) %}
                    {% set taxTotals = taxTotals|merge({ (taxInfo.name): currentTaxData|merge({ 'total': currentTaxData.total + taxInfo.tax }) }) %}
                {% endfor %}
            {% endif %}
            {% if taxItem.payload.inoceanShippingTaxInfo is defined and taxItem.payload.inoceanShippingTaxInfo is not empty %}
                {% for tax in taxItem.payload.inoceanShippingTaxInfo %}
                    {% set currentTaxData = taxTotals[tax.name]|default({ 'rate': tax.rate, 'total': 0 }) %}
                    {% set taxTotals = taxTotals|merge({ (tax.name): currentTaxData|merge({ 'total': currentTaxData.total + tax.tax }) }) %}
                {% endfor %}
            {% endif %}
        {% endfor %}

        {% if taxTotals is not empty %}

            {% for taxName, taxData in taxTotals %}
                {% if taxData.total != 0 %}
                    <dt class="col-7 checkout-aside-summary-label summary-tax">
                        {{ ('salseTaxCanada.checkout.taxes.tax' ~ taxName)|trans({'%taxRate%': taxData.rate})|sw_sanitize }}
                    </dt>
                    <dd class="col-5 checkout-aside-summary-value summary-tax">
                        {{ taxData.total|currency }}
                    </dd>
                {% endif %}
            {% endfor %}

        {% else %}

            {% for taxItem in summary.price.calculatedTaxes %}
                {% if taxItem.taxRate != 0 %}
                    <dt class="col-7 checkout-aside-summary-label summary-tax">
                        {{ 'checkout.summaryTax'|trans({
                            '%rate%': taxItem.taxRate
                        })|sw_sanitize }}
                    </dt>

                    <dd class="col-5 checkout-aside-summary-value summary-tax">
                        {{ taxItem.tax|currency }}
                    </dd>
                {% endif %}
            {% endfor %}

        {% endif %}

    {% else %}
   
        {% for taxItem in summary.price.calculatedTaxes %}
            {% if taxItem.taxRate != 0 %}
                {% block page_checkout_summary_tax %}
                    {% block page_checkout_summary_tax_label %}
                        {# The taxName extension is only present on taxes this plugin calculated. #}
                        {% if taxItem.extensions.taxName.name is defined and taxItem.extensions.taxName.name %}
                            <dt class="col-7 checkout-aside-summary-label summary-tax">
                                {{ ('salseTaxCanada.checkout.taxes.tax' ~ taxItem.extensions.taxName.name)|trans({'%taxRate%': taxItem.taxRate})|sw_sanitize }}
                            </dt>
                        {% else %}
                            <dt class="col-7 checkout-aside-summary-label summary-tax">
                                {{ 'checkout.summaryTax'|trans({
                                    '%rate%': taxItem.taxRate
                                })|sw_sanitize }}
                            </dt>
                        {% endif %}
                    {% endblock %}
                    {% block page_checkout_summary_tax_value %}
                        <dd class="col-5 checkout-aside-summary-value summary-tax">
                            {{ taxItem.tax|currency }}
                        </dd>
                    {% endblock %}
                {% endblock %}
            {% endif %}
        {% endfor %}
        
    {% endif %}
{% endblock %}