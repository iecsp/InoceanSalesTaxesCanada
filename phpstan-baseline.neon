parameters:
	ignoreErrors:
		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: src/Core/Checkout/Cart/Tax/CanadaTaxProvider.php

		-
			message: '#^Using nullsafe method call on non\-nullable type Shopware\\Core\\Checkout\\Customer\\Aggregate\\CustomerAddress\\CustomerAddressEntity\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Core/Checkout/Cart/Tax/CanadaTaxProvider.php
